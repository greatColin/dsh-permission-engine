{
  "name": "@yourname/dsh-permission-engine",
  "version": "0.1.0",
  "description": "DSH permission engine: a configurable responsibility chain for tools/pre-execute decisions",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.bundle.js" },
    "./chain/link": { "types": "./lib/types/chain.d.ts", "default": "./lib/chain/link.js" },
    "./chain/chain": { "types": "./lib/types/chain.d.ts", "default": "./lib/chain/chain.js" },
    "./services/engine": { "types": "./lib/types/services.d.ts", "default": "./lib/services/PermissionEngine.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.bundle.js",
    "lib/chain/**/*.js",
    "lib/integration/**/*.js",
    "lib/services/**/*.js",
    "lib/dev/**/*.js",
    "lib/ui/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "build:client": "node ../../scripts/bundle-client.mjs"
  },
  "dsh": {
    "client": {
      "inject": ["slots", "locale", "host"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true }
  }
}
